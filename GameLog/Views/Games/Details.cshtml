@model GameLog.Models.GameDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>@Model.Game.Title</h1>
<p class="text-muted">@Model.Game.ReleaseYear</p>

<img class="game-cover-large"
     src="~/images/games/@(string.IsNullOrEmpty(Model.Game.ImagePath) ? "placeholder.jpg" : Model.Game.ImagePath)"
     alt="@Model.Game.Title" />

<div>
    <h4>Game</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Game.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Game.Title)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Game.ReleaseYear)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Game.ReleaseYear)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Game.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Model.Game.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
        </dd>

        <dt class="col-sm-2">
            Genres
        </dt>
        <dd class="col-sm-10">
            @if (Model.Game.GameGenres != null && Model.Game.GameGenres.Any())
            {
                @string.Join(", ", Model.Game.GameGenres.Select(gg => gg.Genre.Name))
            }
            else
            {
                <em>None</em>
            }
        </dd>

        <dt class="col-sm-2">Platforms</dt>
        <dd class="col-sm-10">
            @if (Model.Game.GamePlatforms != null && Model.Game.GamePlatforms.Any())
            {
                @string.Join(", ", Model.Game.GamePlatforms.Select(gp => gp.Platform.Name))
            }
            else
            {
                <em>None</em>
            }
        </dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Game.Id">Edit</a>
        <span> | </span>
    }

    <a asp-action="Index">Back to List</a>
</div>

<hr />

@if (User.Identity?.IsAuthenticated == true)
{
    <h4 class="mt-3">Add to My List</h4>

    <form asp-controller="UserGameLists" asp-action="Upsert" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="gameId" value="@Model.Game.Id" />

        <div class="form-group">
            <label>Status</label>
            <select class="form-control" name="status">
                <option value="0">WantToPlay</option>
                <option value="1">Playing</option>
                <option value="2">Played</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success mt-2">Save to My List</button>
        <a class="btn btn-outline-secondary mt-2"
           asp-controller="UserGameLists"
           asp-action="Index">Go to My List</a>
    </form>
}

<hr />

<h4 class="mt-4">Reviews</h4>

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-warning mt-2">
        @TempData["CommentError"]
    </div>
}

@if (TempData["ProfileError"] != null)
{
    <div class="alert alert-warning mt-2">
        @TempData["ProfileError"]
    </div>
}

@if (Model.Reviews.Count == 0)
{
    <p class="text-muted"><em>No reviews yet.</em></p>
}
else
{
    <div class="d-flex flex-column gap-3 mt-3">
        @foreach (var r in Model.Reviews)
        {
            <div class="border rounded-3 p-3">

                <!-- REVIEW HEADER -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="~/images/avatars/@r.AvatarFileName"
                         onerror="this.onerror=null;this.src='/images/avatars/default-avatar.jpg';"
                         alt="Avatar"
                         style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:1px solid #ddd;" />

                    <div>
                        <div class="fw-semibold">@r.DisplayName</div>
                        <div class="text-muted" style="font-size: 0.9rem;">
                            Rating: @r.Rating/10 • @r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(r.Text))
                {
                    <div class="mb-2">@r.Text</div>
                }

                <!-- REACTIONS -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mt-2 d-flex gap-2">
                        <form asp-action="ToggleReaction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@Model.Game.Id" />
                            <input type="hidden" name="reviewId" value="@r.Id" />
                            <input type="hidden" name="isLike" value="true" />

                            <button type="submit"
                                    class="btn btn-sm @(r.UserReactionIsLike == true ? "btn-success" : "btn-outline-success")">
                                👍 @r.LikeCount
                            </button>
                        </form>

                        <form asp-action="ToggleReaction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@Model.Game.Id" />
                            <input type="hidden" name="reviewId" value="@r.Id" />
                            <input type="hidden" name="isLike" value="false" />

                            <button type="submit"
                                    class="btn btn-sm @(r.UserReactionIsLike == false ? "btn-danger" : "btn-outline-danger")">
                                👎 @r.DislikeCount
                            </button>
                        </form>
                    </div>
                }

                <!-- DELETE REVIEW -->
                @if (User.Identity?.IsAuthenticated == true &&
                        (User.IsInRole("Admin") || r.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                {
                    <form asp-action="DeleteReview" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="gameId" value="@Model.Game.Id" />
                        <input type="hidden" name="reviewId" value="@r.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Delete review
                        </button>
                    </form>
                }

                <!-- COMMENTS -->
                <div class="mt-3">
                    <h6 class="mb-2">Comments</h6>

                    @if (r.Comments != null && r.Comments.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2 ms-2">
                            @foreach (var c in r.Comments)
                            {
                                <div class="d-flex align-items-start gap-2">
                                    <img src="~/images/avatars/@c.AvatarFileName"
                                         onerror="this.onerror=null;this.src='/images/avatars/default-avatar.jpg';"
                                         alt="Avatar"
                                         style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid #ddd;" />

                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-baseline justify-content-between">
                                            <div class="d-flex align-items-baseline gap-2">
                                                <span class="fw-semibold">@c.DisplayName</span>
                                                <small class="text-muted">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                            </div>

                                            @if (User.Identity?.IsAuthenticated == true &&
                                                                        (User.IsInRole("Admin") || c.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                                            {
                                                <form asp-action="DeleteComment" method="post" class="ms-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="gameId" value="@Model.Game.Id" />
                                                    <input type="hidden" name="commentId" value="@c.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            }
                                        </div>

                                        <div>@c.Text</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted ms-2"><em>No comments yet.</em></div>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="mt-2 ms-2">
                            <form asp-action="AddComment" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="gameId" value="@Model.Game.Id" />
                                <input type="hidden" name="reviewId" value="@r.Id" />

                                <input class="form-control"
                                       type="text"
                                       name="text"
                                       maxlength="1000"
                                       placeholder="Add a comment..." />

                                <button type="submit" class="btn btn-outline-primary">
                                    Comment
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-2 mt-2">
                            <small class="text-muted"><em>Log in to add a comment.</em></small>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <hr />
    <h4 class="mt-3">Add / Update your review</h4>

    <form asp-action="AddReview" method="post" class="mt-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="gameId" value="@Model.Game.Id" />

        <div class="form-group">
            <label>Rating (1-10)</label>
            <input class="form-control"
                   type="number"
                   name="rating"
                   min="1"
                   max="10"
                   value="8"
                   required />
        </div>

        <div class="form-group mt-2">
            <label>Text</label>
            <textarea class="form-control"
                  name="text"
                  rows="4"
                  maxlength="2000"></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Save review</button>
    </form>
}
else
{
    <p class="text-muted"><em>Log in to add a review.</em></p>
}
